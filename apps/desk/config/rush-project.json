/**
 * This configuration file manages Rush's project-specific build cache settings.
 * More documentation is available on the Rush website: https://rushjs.io
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush-project.schema.json",

  // A README or a changelog is read by no build, so neither is part of the
  // cache key; common/scripts/ci/build-cache-inputs.test.mjs says why.
  "incrementalBuildIgnoredGlobs": ["**/README.md", "**/CHANGELOG.md"],

  "operationSettings": [
    {
      "operationName": "build",
      "outputFolderNames": ["dist"]
    }
  ]
}
