{
  "name": "knights",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run test && npm run compile && vite build",
    "build:watch": "",
    "compile": "tsc",
    "dev": "vite",
    "generate:pwa-assets": "pwa-assets-generator",
    "preview": "vite preview",
    "test": "if find src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.test.js' -o -name '*.test.jsx' \\) | grep -q .; then vitest run --environment jsdom; else echo 'No tests found, skipping'; fi",
    "test:watch": "vitest --environment jsdom"
  },
  "dependencies": {
    "@apendua.dev/media": "workspace:*",
    "@types/node": "^24.7.0",
    "@types/three": "~0.185.0",
    "@vite-pwa/assets-generator": "^1.0.1",
    "eslint": "^9.37.0",
    "justdom": "workspace:*",
    "justdom-signal": "workspace:*",
    "justdom-three": "workspace:*",
    "justdom-three-ui": "workspace:*",
    "justdom-vite-hmr": "workspace:*",
    "justdom-xr": "workspace:*",
    "three": "~0.185.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
