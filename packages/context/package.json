{
  "name": "@apendua.dev/context",
  "version": "1.0.0",
  "private": true,
  "description": "The simplest possible context",
  "keywords": [
    "context"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./src/index.js",
      "types": "./lib-types/index.d.ts"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "tsc && npm run build:package.json && npm run build:types",
    "build:package.json": "echo '{\"type\":\"commonjs\"}' > lib/package.json",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3"
  }
}
