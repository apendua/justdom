{
  "name": "@apendua.dev/diagnostics",
  "version": "1.0.0",
  "private": true,
  "description": "The frame rate readout every headset app wears: a small head-locked panel and the meter behind it",
  "keywords": [
    "diagnostics",
    "performance",
    "three",
    "webxr"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run test && npm run compile && npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "tsc --project tsconfig.build.json",
    "test": "npm run test:typecheck && node --import ./src/test/setup-jsdom.js --test \"src/**/*.test.js\"",
    "test:coverage": "npm run test:typecheck && node --import ./src/test/setup-jsdom.js --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --import ./src/test/setup-jsdom.js --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apendua/freedom": "workspace:*",
    "@apendua/jsdom-env": "workspace:*",
    "@apendua/justdom": "workspace:*",
    "@apendua/signal": "workspace:*",
    "@apendua/vite-hmr": "workspace:*",
    "@types/node": "^24.7.0",
    "@types/three": "~0.180.0",
    "eslint": "^9.37.0",
    "three": "~0.180.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@apendua/freedom": "workspace:*",
    "@apendua/justdom": "workspace:*",
    "@apendua/signal": "workspace:*",
    "three": "~0.180.0"
  }
}
