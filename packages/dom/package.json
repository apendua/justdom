{
  "name": "@apendua.dev/dom",
  "version": "1.0.0",
  "private": true,
  "description": "Reactive, non-VDOM DOM renderer built on @apendua.dev/signal",
  "keywords": [
    "dom",
    "reactive",
    "renderer",
    "signals"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    },
    "./hydrate": {
      "types": "./lib-types/hydrate.d.ts",
      "import": "./src/hydrate.js"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run test && npm run compile && npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "tsc --project tsconfig.build.json",
    "test": "npm run test:typecheck && node --import ./src/test/setup-jsdom.js --test \"src/**/*.test.js\"",
    "test:coverage": "npm run test:typecheck && node --import ./src/test/setup-jsdom.js --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --import ./src/test/setup-jsdom.js --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "@apendua.dev/signal": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apendua.dev/hmr": "workspace:*",
    "@apendua.dev/jsdom-env": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "typescript": "^6.0.2"
  }
}
