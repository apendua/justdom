{
  "name": "@apendua.dev/geometry",
  "version": "1.0.0",
  "private": true,
  "description": "Geometry utils for hexagonal grids",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./src/index.js",
      "types": "./lib-types/index.d.ts"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run test && npm run compile && npm run build:package.json && npm run build:types",
    "build:package.json": "echo '{\"type\":\"commonjs\"}' > lib/package.json",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "tsc",
    "test": "node --test \"src/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3"
  }
}
