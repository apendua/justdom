{
  "name": "@apendua.dev/geometry",
  "version": "1.0.0",
  "private": true,
  "description": "Geometry utils for hexagonal grids",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./src/index.js",
      "types": "./lib-types/index.d.ts"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "tsc && npm run build:package.json && npm run build:types",
    "build:package.json": "echo '{\"type\":\"commonjs\"}' > lib/package.json",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "eslint": "^9.2.0",
    "jest": "^29.7.0",
    "jest-silent-reporter": "^0.6.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
