{
  "name": "@apendua/geometry",
  "version": "0.1.1",
  "description": "Geometry utils for hexagonal grids",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apendua/justdom.git",
    "directory": "packages/geometry"
  },
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run --loglevel=warn test && npm run --loglevel=warn build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "npm run --loglevel=warn test:syntax && npm run --loglevel=warn test:typecheck && node --test \"src/**/*.test.js\"",
    "test:coverage": "npm run --loglevel=warn test:typecheck && node --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:syntax": "node --experimental-vm-modules --no-warnings ../../common/scripts/check-native-syntax.mjs src",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --test --watch \"src/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
