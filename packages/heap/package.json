{
  "name": "@apendua.dev/heap",
  "version": "1.0.0",
  "private": true,
  "description": "A binary heap implementation",
  "keywords": [
    "heap",
    "data structure",
    "priority queue"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "require": "./lib/Heap.js",
      "import": "./src/Heap.js",
      "types": "./lib-types/Heap.d.ts"
    }
  },
  "main": "./lib/Heap.js",
  "module": "./src/Heap.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "tsc && npm run build:package.json && npm run build:types && npm run test:lib",
    "build:package.json": "echo '{\"type\":\"commonjs\"}' > lib/package.json",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:lib": "jest --config jest.lib.config.cjs",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3"
  }
}
