{
  "name": "@apendua/vite-hmr",
  "version": "1.0.0",
  "private": true,
  "description": "A Vite plugin that preserves @apendua/signal component state across hot module reloads",
  "keywords": [
    "vite",
    "vite-plugin",
    "hmr",
    "hot-reload",
    "signals"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    },
    "./plugin": {
      "types": "./lib-types/plugin.d.ts",
      "import": "./src/plugin.js"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run test && npm run compile",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "npm run build:types",
    "test": "npm run test:typecheck && node --test \"src/**/*.test.js\"",
    "test:coverage": "npm run test:typecheck && node --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "typescript": "^6.0.2",
    "vite": "^7.1.9"
  },
  "peerDependencies": {
    "vite": "^6.0.1"
  }
}
