{
  "name": "@apendua.dev/hmr",
  "version": "1.0.0",
  "private": true,
  "description": "A vite plugin for hot module replacement",
  "keywords": [
    "compare",
    "json",
    "ordering"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./lib-types/index.d.ts"
    },
    "./plugin": {
      "import": "./src/plugin.js",
      "types": "./lib-types/plugin.d.ts"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "rxjs": "^7.5.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "eslint": "^9.2.0",
    "fast-check": "^3.23.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "peerDependencies": {
    "vite": "^6.0.1"
  }
}
