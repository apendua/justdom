{
  "name": "@apendua.dev/hmr",
  "version": "1.0.0",
  "private": true,
  "description": "A vite plugin for hot module replacement",
  "keywords": [
    "compare",
    "json",
    "ordering"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./lib-types/index.d.ts"
    },
    "./plugin": {
      "import": "./src/plugin.js",
      "types": "./lib-types/plugin.d.ts"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "peerDependencies": {
    "vite": "^6.0.1"
  }
}
