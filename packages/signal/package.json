{
  "name": "@apendua/signal",
  "version": "0.10.0",
  "description": "A dependency-tracked reactive signals library",
  "keywords": [
    "signals",
    "reactivity",
    "reactive-programming",
    "observable",
    "rxjs",
    "state-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apendua/apendua.dev.git",
    "directory": "packages/signal"
  },
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    },
    "./rxjs": {
      "types": "./lib-types/rxjs.d.ts",
      "import": "./src/rxjs.js"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "src",
    "lib-types"
  ],
  "scripts": {
    "bench": "node --test \"src/**/*.bench.js\"",
    "build": "npm run test && npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "npm run test:syntax && npm run test:typecheck && node --test \"src/**/*.test.js\"",
    "test:coverage": "npm run test:typecheck && node --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:syntax": "node --experimental-vm-modules --no-warnings ../../common/scripts/check-native-syntax.mjs src",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --test --watch \"src/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
