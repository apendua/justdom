{
  "name": "@apendua.dev/signal",
  "version": "0.1.0",
  "private": true,
  "description": "A custom implementation of signals",
  "keywords": [
    "signals",
    "reactivity",
    "observable"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./src/index.js",
      "types": "./lib-types/index.d.ts"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run test && npm run compile && npm run build:package.json && npm run build:types",
    "build:package.json": "echo '{\"type\":\"commonjs\"}' > lib/package.json",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "tsc",
    "test": "node --test \"src/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "@apendua.dev/heap": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
