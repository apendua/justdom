{
  "name": "@apendua/signal",
  "version": "0.1.0",
  "description": "A dependency-tracked reactive signals library built on RxJS",
  "keywords": [
    "signals",
    "reactivity",
    "reactive-programming",
    "observable",
    "rxjs",
    "state-management"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "bench": "node --test \"src/**/*.bench.js\"",
    "build": "npm run test && npm run compile && npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "tsc --project tsconfig.build.json",
    "test": "npm run test:typecheck && node --test \"src/**/*.test.js\"",
    "test:coverage": "npm run test:typecheck && node --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apendua/vite-hmr": "workspace:*",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
