{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "noImplicitAny": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "sourceRoot": "./src",
    "typeRoots": ["./types", "./node_modules/@types"],
    "rootDirs": ["./src"],
    "rootDir": "./src",
    "outDir": "./lib"
  },
  "include": ["src"]
}
