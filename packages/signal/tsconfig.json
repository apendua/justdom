{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "sourceRoot": "./src",
    "typeRoots": ["./types", "./node_modules/@types"],
    "rootDirs": ["./src"],
    "rootDir": "./src",
    "outDir": "./lib"
  },
  "include": ["src"],
  "extends": "../../common/config/typescript/tsconfig.package-base.json",
  "exclude": ["src/**/*.test.*", "src/test/**", "src/testUtils/**"]
}
