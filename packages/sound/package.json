{
  "name": "@apendua.dev/sound",
  "version": "1.0.0",
  "private": true,
  "description": "The noises the demos make: waveforms generated in code, and the three.js voices that place them in the room",
  "keywords": [
    "audio",
    "sound",
    "three",
    "webxr"
  ],
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-es/index.d.ts",
      "import": "./lib-es/index.js"
    }
  },
  "main": "./lib/index.js",
  "module": "./lib-es/index.js",
  "files": [
    "src",
    "lib",
    "lib-es"
  ],
  "scripts": {
    "build": "npm run test && npm run compile",
    "compile": "tsc --project tsconfig.build.json",
    "test": "npm run test:typecheck && tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "npm run test:typecheck && tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "tsx --test --watch \"src/**/*.test.ts\""
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apendua/signal": "workspace:*",
    "@types/node": "^24.7.0",
    "@types/three": "~0.180.0",
    "eslint": "^9.37.0",
    "three": "~0.180.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@apendua/signal": "workspace:*",
    "three": "^0.180.0"
  }
}
