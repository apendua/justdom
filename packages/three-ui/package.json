{
  "name": "justdom-three-ui",
  "version": "0.0.0",
  "description": "The widgets a panel is made of -- dropdown, keyboard, scrollable and a frame rate readout -- built out of ordinary DOM so they work on a page and inside a justdom-three portal alike",
  "keywords": [
    "ui",
    "widgets",
    "dropdown",
    "keyboard",
    "scrollbar",
    "webxr",
    "three",
    "signals"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apendua/justdom.git",
    "directory": "packages/three-ui"
  },
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "main": "./lib/index.js",
  "module": "./src/index.js",
  "files": [
    "lib",
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run test && npm run compile && npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "tsc --project tsconfig.build.json",
    "test": "npm run test:typecheck && node --import ./src/test/setup-jsdom.js --test \"src/**/*.test.js\"",
    "test:coverage": "npm run test:typecheck && node --import ./src/test/setup-jsdom.js --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --import ./src/test/setup-jsdom.js --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@justdom/jsdom-env": "workspace:*",
    "@types/node": "^24.7.0",
    "@types/three": "~0.185.0",
    "eslint": "^9.37.0",
    "justdom": "workspace:*",
    "justdom-signal": "workspace:*",
    "justdom-three": "workspace:*",
    "justdom-vite-hmr": "workspace:*",
    "three": "~0.185.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "justdom": "workspace:*",
    "justdom-signal": "workspace:*",
    "justdom-three": "workspace:*",
    "three": ">=0.180.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
