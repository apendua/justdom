/**
 * This configuration file manages Rush's project-specific build cache settings.
 * More documentation is available on the Rush website: https://rushjs.io
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush-project.schema.json",

  // Markdown is read by nothing the build runs, so an edit to a README or
  // the changelog leaves this project's cache key, and every key downstream
  // of it, as it was.
  "incrementalBuildIgnoredGlobs": ["**/*.md"],

  "operationSettings": [
    {
      "operationName": "build",
      "outputFolderNames": ["lib-types"]
    }
  ]
}
