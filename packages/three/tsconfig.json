{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "noImplicitAny": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "sourceRoot": "./src",
    "typeRoots": [
      "./src/types",
      "./node_modules/@types",
      "./node_modules/@webgpu/types"
    ],
    "rootDirs": ["./src"],
    "rootDir": "./src",
    "outDir": "./lib"
  },
  "include": ["src"]
}
