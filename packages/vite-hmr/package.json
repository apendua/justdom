{
  "name": "@apendua/vite-hmr",
  "version": "0.5.0",
  "description": "A Vite plugin that preserves @apendua/signal component state across hot module reloads",
  "keywords": [
    "vite",
    "vite-plugin",
    "hmr",
    "hot-reload",
    "signals"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apendua/apendua.dev.git",
    "directory": "packages/vite-hmr"
  },
  "license": "MIT",
  "author": "apendua",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./src/index.js"
    },
    "./plugin": {
      "types": "./lib-types/plugin.d.ts",
      "import": "./src/plugin.js"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "src",
    "lib-types"
  ],
  "scripts": {
    "build": "npm run test && npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "npm run test:syntax && npm run test:typecheck && node --test \"src/**/*.test.js\"",
    "test:coverage": "npm run test:typecheck && node --test --experimental-test-coverage \"src/**/*.test.js\"",
    "test:syntax": "node --experimental-vm-modules --no-warnings ../../common/scripts/check-native-syntax.mjs src",
    "test:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "node --test --watch \"src/**/*.test.js\""
  },
  "dependencies": {
    "@apendua/signal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.9"
  },
  "peerDependencies": {
    "vite": "^6.0.1"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
